{
  "info": {
    "name": "Gestion des stages — services SOAP (Postman)",
    "description": "Les trois services SOAP testés avec Postman (outil équivalent à SoapUI). Chaque requête contient l'enveloppe SOAP et l'en-tête WS-Security. À lancer sur une base neuve.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "soapUrl",
      "value": "http://localhost:8090/ws"
    }
  ],
  "item": [
    {
      "name": "0. Contrats WSDL",
      "item": [
        {
          "name": "WSDL du service Etudiants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{soapUrl}}/etudiants?wsdl"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Opération verifierEtudiant décrite\", () => pm.expect(pm.response.text()).to.include('verifierEtudiant'));"
                ]
              }
            }
          ]
        },
        {
          "name": "WSDL du service Entreprises",
          "request": {
            "method": "GET",

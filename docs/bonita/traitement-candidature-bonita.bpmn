<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_GestionStages" targetNamespace="http://stages.universite.com/processus"
             exporter="generer_bpmn_bonita.py" exporterVersion="1.0">
  <error id="ErreurTechnique" name="Service indisponible" errorCode="ERREUR_TECHNIQUE"/>
  <collaboration id="Collaboration">
    <participant id="PoolPlateforme" name="Traitement candidature stage" processRef="TraitementCandidature"/>
  </collaboration>
  <process id="TraitementCandidature" name="Traitement candidature stage" isExecutable="true">
    <documentation>Traitement d'une candidature de stage, du dépôt à la décision finale. Variante pour Bonita : flux à plat, une bordure d'erreur par tâche critique.</documentation>
    <laneSet id="LaneSet">
      <lane id="laneEtudiant" name="Étudiant">
        <flowNodeRef>debut</flowNodeRef>
      </lane>
      <lane id="laneOrchestrateur" name="Orchestrateur SOA (services SOAP / REST)">
        <flowNodeRef>receptionner</flowNodeRef>
        <flowNodeRef>verifierEtudiant</flowNodeRef>
        <flowNodeRef>err_verifierEtudiant</flowNodeRef>
        <flowNodeRef>gwEligible</flowNodeRef>
        <flowNodeRef>verifierOffre</flowNodeRef>
        <flowNodeRef>err_verifierOffre</flowNodeRef>
        <flowNodeRef>controler</flowNodeRef>
        <flowNodeRef>err_controler</flowNodeRef>
        <flowNodeRef>gwRecevable</flowNodeRef>
        <flowNodeRef>notifierRejet</flowNodeRef>
        <flowNodeRef>finRejet</flowNodeRef>
        <flowNodeRef>enregistrer</flowNodeRef>
        <flowNodeRef>err_enregistrer</flowNodeRef>
        <flowNodeRef>notifierConfirmation</flowNodeRef>
        <flowNodeRef>notifierEntreprise</flowNodeRef>
        <flowNodeRef>majDecision</flowNodeRef>
        <flowNodeRef>err_majDecision</flowNodeRef>
        <flowNodeRef>notifierResultat</flowNodeRef>
        <flowNodeRef>gwAcceptee</flowNodeRef>
        <flowNodeRef>finRefus</flowNodeRef>
        <flowNodeRef>creerStage</flowNodeRef>
        <flowNodeRef>err_creerStage</flowNodeRef>
        <flowNodeRef>majEtudiant</flowNodeRef>
        <flowNodeRef>err_majEtudiant</flowNodeRef>
        <flowNodeRef>finAcceptee</flowNodeRef>
      </lane>
      <lane id="laneEntreprise" name="Entreprise partenaire">
        <flowNodeRef>evaluer</flowNodeRef>
        <flowNodeRef>timerRelance</flowNodeRef>
        <flowNodeRef>relancerEntreprise</flowNodeRef>
        <flowNodeRef>finRelance</flowNodeRef>
        <flowNodeRef>gwDecision</flowNodeRef>
        <flowNodeRef>notifierComplement</flowNodeRef>
      </lane>
      <lane id="laneResponsable" name="Responsable des stages">
        <flowNodeRef>journaliser</flowNodeRef>
        <flowNodeRef>traiterIncident</flowNodeRef>
        <flowNodeRef>gwIncident</flowNodeRef>
        <flowNodeRef>notifierIncident</flowNodeRef>
        <flowNodeRef>finAbandon</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="debut" name="Candidature soumise"/>
    <serviceTask id="receptionner" name="Recevoir dossier">
      <documentation>Contrôle de forme des données saisies (matricule, offre, lettre, CV).</documentation>
    </serviceTask>
    <serviceTask id="verifierEtudiant" name="Vérifier étudiant">
      <documentation>SOAP /ws/etudiants : verifierEtudiant(matricule) puis consulterEtudiant(matricule).</documentation>
    </serviceTask>
    <boundaryEvent id="err_verifierEtudiant" name="Erreur" attachedToRef="verifierEtudiant" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <exclusiveGateway id="gwEligible" name="Étudiant éligible ?" default="fNonEligible"/>
    <serviceTask id="verifierOffre" name="Vérifier offre">
      <documentation>SOAP /ws/offres : consulterOffre, verifierCompatibilite ; SOAP /ws/entreprises : verifierEntreprise, consulterEntreprise.</documentation>
    </serviceTask>
    <boundaryEvent id="err_verifierOffre" name="Erreur" attachedToRef="verifierOffre" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <serviceTask id="controler" name="Contrôle dossier">
      <documentation>SOAP verifierDisponibilite(offreId) ; REST GET /api/candidatures?matricule=..&amp;offreId=.. (doublon).</documentation>
    </serviceTask>
    <boundaryEvent id="err_controler" name="Erreur" attachedToRef="controler" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <exclusiveGateway id="gwRecevable" name="5. Recevable ?" default="fNonRecevable"/>
    <serviceTask id="notifierRejet" name="Notifier rejet">
      <documentation>REST POST /api/notifications, type REJET_CANDIDATURE (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <endEvent id="finRejet" name="Candidature rejetée"/>
    <serviceTask id="enregistrer" name="Inscrire demande">
      <documentation>REST POST /api/candidatures → candidatureId.</documentation>
    </serviceTask>
    <boundaryEvent id="err_enregistrer" name="Erreur" attachedToRef="enregistrer" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <serviceTask id="notifierConfirmation" name="Confirme dépôt">
      <documentation>REST POST /api/notifications, type CONFIRMATION_DEPOT (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <serviceTask id="notifierEntreprise" name="Prévenir société">
      <documentation>REST POST /api/notifications, type RECEPTION_CANDIDATURE (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <userTask id="evaluer" name="Évaluer">
      <documentation>Prise en charge par l'entreprise (REST PATCH statut EN_COURS_EVALUATION), puis formulaire : decision (ACCEPTEE / REFUSEE / COMPLEMENT), commentaireDecision, dateDebut, dateFin, tuteur.</documentation>
    </userTask>
    <boundaryEvent id="timerRelance" name="Délai dépassé" attachedToRef="evaluer" cancelActivity="false">
      <timerEventDefinition><timeDuration xsi:type="tFormalExpression">P3D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="relancerEntreprise" name="Relancer société">
      <documentation>REST POST /api/notifications, type RELANCE_DECISION (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <endEvent id="finRelance" name="Relance envoyée"/>
    <exclusiveGateway id="gwDecision" name="Décision ?" default="fDecisionFinale"/>
    <serviceTask id="notifierComplement" name="Demander pièces">
      <documentation>REST POST /api/notifications, type DEMANDE_COMPLEMENT (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <serviceTask id="majDecision" name="Valider décision">
      <documentation>REST PATCH /api/candidatures/{id}/statut {statut: decision, motif: commentaireDecision}.</documentation>
    </serviceTask>
    <boundaryEvent id="err_majDecision" name="Erreur" attachedToRef="majDecision" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <serviceTask id="notifierResultat" name="Notifier résultat">
      <documentation>REST POST /api/notifications, type ACCEPTATION ou REFUS (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <exclusiveGateway id="gwAcceptee" name="Acceptée ?" default="fRefusee"/>
    <endEvent id="finRefus" name="Refus notifié"/>
    <serviceTask id="creerStage" name="Créer stage">
      <documentation>REST POST /api/stages → stageId.</documentation>
    </serviceTask>
    <boundaryEvent id="err_creerStage" name="Erreur" attachedToRef="creerStage" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <serviceTask id="majEtudiant" name="MAJ étudiant">
      <documentation>SOAP changerStatutEtudiant(matricule, EN_STAGE) ; SOAP reserverPlace(offreId).</documentation>
    </serviceTask>
    <boundaryEvent id="err_majEtudiant" name="Erreur" attachedToRef="majEtudiant" cancelActivity="true">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <endEvent id="finAcceptee" name="Stage créé"/>
    <serviceTask id="journaliser" name="Tracer incident">
      <documentation>Enregistre serviceEnErreur, messageErreur et etapeCourante.</documentation>
    </serviceTask>
    <userTask id="traiterIncident" name="Traiter incident">
      <documentation>Formulaire : actionIncident (RELANCER / ABANDONNER).</documentation>
    </userTask>
    <exclusiveGateway id="gwIncident" name="Action ?" default="fAbandon"/>
    <serviceTask id="notifierIncident" name="Notifier abandon">
      <documentation>REST POST /api/notifications, type INCIDENT_TRAITEMENT (connecteur : ignorer l'erreur).</documentation>
    </serviceTask>
    <endEvent id="finAbandon" name="Traitement abandonné"/>
    <sequenceFlow id="fErr_verifierEtudiant" sourceRef="err_verifierEtudiant" targetRef="journaliser"/>
    <sequenceFlow id="fErr_verifierOffre" sourceRef="err_verifierOffre" targetRef="journaliser"/>
    <sequenceFlow id="fErr_controler" sourceRef="err_controler" targetRef="journaliser"/>
    <sequenceFlow id="fErr_enregistrer" sourceRef="err_enregistrer" targetRef="journaliser"/>
    <sequenceFlow id="fErr_majDecision" sourceRef="err_majDecision" targetRef="journaliser"/>
    <sequenceFlow id="fErr_creerStage" sourceRef="err_creerStage" targetRef="journaliser"/>
    <sequenceFlow id="fErr_majEtudiant" sourceRef="err_majEtudiant" targetRef="journaliser"/>
    <sequenceFlow id="f1" sourceRef="debut" targetRef="receptionner"/>
    <sequenceFlow id="f2" sourceRef="receptionner" targetRef="verifierEtudiant"/>
    <sequenceFlow id="f3" sourceRef="verifierEtudiant" targetRef="gwEligible"/>
    <sequenceFlow id="fEligible" name="oui" sourceRef="gwEligible" targetRef="verifierOffre">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">etudiantEligible</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNonEligible" name="non" sourceRef="gwEligible" targetRef="notifierRejet"/>
    <sequenceFlow id="f4" sourceRef="verifierOffre" targetRef="controler"/>
    <sequenceFlow id="f5" sourceRef="controler" targetRef="gwRecevable"/>
    <sequenceFlow id="fRecevable" name="oui" sourceRef="gwRecevable" targetRef="enregistrer">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">recevable</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNonRecevable" name="non" sourceRef="gwRecevable" targetRef="notifierRejet"/>
    <sequenceFlow id="fRejet" sourceRef="notifierRejet" targetRef="finRejet"/>
    <sequenceFlow id="f6" sourceRef="enregistrer" targetRef="notifierConfirmation"/>
    <sequenceFlow id="f7" sourceRef="notifierConfirmation" targetRef="notifierEntreprise"/>
    <sequenceFlow id="f8" sourceRef="notifierEntreprise" targetRef="evaluer"/>
    <sequenceFlow id="f10" sourceRef="evaluer" targetRef="gwDecision"/>
    <sequenceFlow id="fComplement" name="complément" sourceRef="gwDecision" targetRef="notifierComplement">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">decision == &quot;COMPLEMENT&quot;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRetour" sourceRef="notifierComplement" targetRef="evaluer"/>
    <sequenceFlow id="fDecisionFinale" name="acceptée / refusée" sourceRef="gwDecision" targetRef="majDecision"/>
    <sequenceFlow id="fTimer" sourceRef="timerRelance" targetRef="relancerEntreprise"/>
    <sequenceFlow id="fRelance" sourceRef="relancerEntreprise" targetRef="finRelance"/>
    <sequenceFlow id="f11" sourceRef="majDecision" targetRef="notifierResultat"/>
    <sequenceFlow id="f12" sourceRef="notifierResultat" targetRef="gwAcceptee"/>
    <sequenceFlow id="fAcceptee" name="oui" sourceRef="gwAcceptee" targetRef="creerStage">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">decision == &quot;ACCEPTEE&quot;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRefusee" name="non" sourceRef="gwAcceptee" targetRef="finRefus"/>
    <sequenceFlow id="f13" sourceRef="creerStage" targetRef="majEtudiant"/>
    <sequenceFlow id="f14" sourceRef="majEtudiant" targetRef="finAcceptee"/>
    <sequenceFlow id="f15" sourceRef="journaliser" targetRef="traiterIncident"/>
    <sequenceFlow id="f16" sourceRef="traiterIncident" targetRef="gwIncident"/>
    <sequenceFlow id="fRelancerA" name="relancer (vérifications)" sourceRef="gwIncident" targetRef="verifierEtudiant">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">actionIncident == &quot;RELANCER&quot; &amp;&amp; etapeCourante == &quot;VERIFICATIONS&quot;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRelancerB" name="relancer (enregistrement)" sourceRef="gwIncident" targetRef="enregistrer">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">actionIncident == &quot;RELANCER&quot; &amp;&amp; etapeCourante == &quot;ENREGISTREMENT&quot;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRelancerC" name="relancer (finalisation)" sourceRef="gwIncident" targetRef="majDecision">
      <conditionExpression xsi:type="tFormalExpression" language="http://groovy.codehaus.org/">actionIncident == &quot;RELANCER&quot; &amp;&amp; etapeCourante == &quot;FINALISATION&quot;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fAbandon" name="abandonner" sourceRef="gwIncident" targetRef="notifierIncident"/>
    <sequenceFlow id="f17" sourceRef="notifierIncident" targetRef="finAbandon"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagramme">
    <bpmndi:BPMNPlane id="Plan" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="PoolPlateforme_di" bpmnElement="PoolPlateforme" isHorizontal="true"><dc:Bounds x="30" y="30" width="3450" height="970"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneEtudiant_di" bpmnElement="laneEtudiant" isHorizontal="true"><dc:Bounds x="60" y="30" width="3420" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneOrchestrateur_di" bpmnElement="laneOrchestrateur" isHorizontal="true"><dc:Bounds x="60" y="160" width="3420" height="360"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneEntreprise_di" bpmnElement="laneEntreprise" isHorizontal="true"><dc:Bounds x="60" y="520" width="3420" height="290"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="laneResponsable_di" bpmnElement="laneResponsable" isHorizontal="true"><dc:Bounds x="60" y="810" width="3420" height="190"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="debut_di" bpmnElement="debut"><dc:Bounds x="218" y="67" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="181" y="107" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receptionner_di" bpmnElement="receptionner"><dc:Bounds x="161" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verifierEtudiant_di" bpmnElement="verifierEtudiant"><dc:Bounds x="362" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_verifierEtudiant_di" bpmnElement="err_verifierEtudiant"><dc:Bounds x="469" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwEligible_di" bpmnElement="gwEligible" isMarkerVisible="true"><dc:Bounds x="589" y="245" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="559" y="215" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verifierOffre_di" bpmnElement="verifierOffre"><dc:Bounds x="716" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_verifierOffre_di" bpmnElement="err_verifierOffre"><dc:Bounds x="823" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="controler_di" bpmnElement="controler"><dc:Bounds x="916" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_controler_di" bpmnElement="err_controler"><dc:Bounds x="1023" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwRecevable_di" bpmnElement="gwRecevable" isMarkerVisible="true"><dc:Bounds x="1143" y="245" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1113" y="215" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierRejet_di" bpmnElement="notifierRejet"><dc:Bounds x="1093" y="392" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finRejet_di" bpmnElement="finRejet"><dc:Bounds x="1292" y="412" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1255" y="452" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enregistrer_di" bpmnElement="enregistrer"><dc:Bounds x="1270" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_enregistrer_di" bpmnElement="err_enregistrer"><dc:Bounds x="1377" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierConfirmation_di" bpmnElement="notifierConfirmation"><dc:Bounds x="1471" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierEntreprise_di" bpmnElement="notifierEntreprise"><dc:Bounds x="1671" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluer_di" bpmnElement="evaluer"><dc:Bounds x="2049" y="572" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timerRelance_di" bpmnElement="timerRelance"><dc:Bounds x="2051" y="630" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1939" y="652" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="relancerEntreprise_di" bpmnElement="relancerEntreprise"><dc:Bounds x="1766" y="678" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finRelance_di" bpmnElement="finRelance"><dc:Bounds x="1669" y="697" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1632" y="737" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwDecision_di" bpmnElement="gwDecision" isMarkerVisible="true"><dc:Bounds x="2288" y="585" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="2258" y="555" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierComplement_di" bpmnElement="notifierComplement"><dc:Bounds x="2238" y="678" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="majDecision_di" bpmnElement="majDecision"><dc:Bounds x="2391" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_majDecision_di" bpmnElement="err_majDecision"><dc:Bounds x="2498" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierResultat_di" bpmnElement="notifierResultat"><dc:Bounds x="2592" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwAcceptee_di" bpmnElement="gwAcceptee" isMarkerVisible="true"><dc:Bounds x="2819" y="245" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="2789" y="215" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finRefus_di" bpmnElement="finRefus"><dc:Bounds x="2826" y="412" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2789" y="452" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="creerStage_di" bpmnElement="creerStage"><dc:Bounds x="2946" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_creerStage_di" bpmnElement="err_creerStage"><dc:Bounds x="3053" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="majEtudiant_di" bpmnElement="majEtudiant"><dc:Bounds x="3146" y="232" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="err_majEtudiant_di" bpmnElement="err_majEtudiant"><dc:Bounds x="3253" y="290" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finAcceptee_di" bpmnElement="finAcceptee"><dc:Bounds x="3345" y="252" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="3308" y="292" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="journaliser_di" bpmnElement="journaliser"><dc:Bounds x="1105" y="872" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="traiterIncident_di" bpmnElement="traiterIncident"><dc:Bounds x="1306" y="872" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gwIncident_di" bpmnElement="gwIncident" isMarkerVisible="true"><dc:Bounds x="1544" y="885" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1514" y="855" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifierIncident_di" bpmnElement="notifierIncident"><dc:Bounds x="1719" y="872" width="150" height="75"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finAbandon_di" bpmnElement="finAbandon"><dc:Bounds x="1964" y="892" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1927" y="932" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="fErr_verifierEtudiant_di" bpmnElement="fErr_verifierEtudiant"><di:waypoint x="487" y="326"/><di:waypoint x="487" y="796"/><di:waypoint x="1180" y="796"/><di:waypoint x="1180" y="872"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fErr_verifierOffre_di" bpmnElement="fErr_verifierOffre"><di:waypoint x="841" y="326"/><di:waypoint x="841" y="796"/><di:waypoint x="1180" y="796"/><di:waypoint x="1180" y="872"/></bpmndi:BPMNEdge>

<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://stages.universite.com/processus">

  <!-- Généré par tools/generer_bpmn.py : ne pas éditer à la main -->
  <error id="ErreurTechnique" name="Service indisponible" errorCode="ERREUR_TECHNIQUE"/>

  <collaboration id="Collaboration">
    <participant id="Participant_Plateforme" name="Plateforme de gestion des stages" processRef="traitementCandidature"/>
  </collaboration>

  <process id="traitementCandidature" name="Traitement d'une candidature de stage" isExecutable="true">
    <documentation>Orchestration du traitement d'une candidature, du dépôt à la décision finale.</documentation>
    <laneSet id="LaneSet_1">
      <lane id="laneEtudiant" name="Étudiant">
        <flowNodeRef>debut</flowNodeRef>
        <flowNodeRef>notifierRejet</flowNodeRef>
        <flowNodeRef>finRejet</flowNodeRef>
        <flowNodeRef>notifierComplement</flowNodeRef>
        <flowNodeRef>finTraitee</flowNodeRef>
      </lane>
      <lane id="laneOrchestrateur" name="Orchestrateur SOA (services SOAP / REST)">
        <flowNodeRef>receptionner</flowNodeRef>
        <flowNodeRef>spVerifications</flowNodeRef>
        <flowNodeRef>errA</flowNodeRef>
        <flowNodeRef>gwRecevable</flowNodeRef>
        <flowNodeRef>spEnregistrement</flowNodeRef>
        <flowNodeRef>errB</flowNodeRef>
        <flowNodeRef>spFinalisation</flowNodeRef>
        <flowNodeRef>errC</flowNodeRef>
      </lane>
      <lane id="laneEntreprise" name="Entreprise partenaire">
        <flowNodeRef>evaluer</flowNodeRef>
        <flowNodeRef>timerRelance</flowNodeRef>
        <flowNodeRef>relancerEntreprise</flowNodeRef>
        <flowNodeRef>finRelance</flowNodeRef>
        <flowNodeRef>gwDecision</flowNodeRef>
      </lane>
      <lane id="laneResponsable" name="Responsable des stages">
        <flowNodeRef>journaliser</flowNodeRef>
        <flowNodeRef>traiterIncident</flowNodeRef>
        <flowNodeRef>gwIncident</flowNodeRef>
        <flowNodeRef>notifierIncident</flowNodeRef>
        <flowNodeRef>finAbandon</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="debut" name="Candidature soumise"/>
    <serviceTask id="receptionner" name="1. Réceptionner la candidature" flowable:class="com.universite.stages.bpmn.delegates.ReceptionnerCandidatureDelegate">
      <documentation>Contrôle de forme des données saisies et initialisation du contexte du processus.</documentation>
    </serviceTask>
    <subProcess id="spVerifications" name="Vérifications de recevabilité">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('etapeCourante', 'VERIFICATIONS')}"/>
      </extensionElements>
      <startEvent id="debutA" name=""/>
      <serviceTask id="verifierEtudiant" name="2. Vérifier l'étudiant [SOAP Étudiants]" flowable:class="com.universite.stages.bpmn.delegates.VerifierEtudiantDelegate">
        <documentation>verifierEtudiant + consulterEtudiant</documentation>
      </serviceTask>
      <exclusiveGateway id="gwEligible" name="Étudiant éligible ?" default="fNonEligible"/>
      <serviceTask id="verifierOffre" name="3. Vérifier l'offre et l'entreprise [SOAP Offres / Entreprises]" flowable:class="com.universite.stages.bpmn.delegates.VerifierOffreDelegate">
        <documentation>consulterOffre, verifierEntreprise, consulterEntreprise, verifierCompatibilite</documentation>
      </serviceTask>
      <serviceTask id="controler" name="4. Contrôler la candidature [SOAP Offres / REST Candidatures]" flowable:class="com.universite.stages.bpmn.delegates.ControlerCandidatureDelegate">
        <documentation>Date limite, places disponibles, absence de doublon</documentation>
      </serviceTask>
      <endEvent id="finA" name="Vérifications terminées"/>
      <endEvent id="finNonEligible" name="Étudiant non éligible"/>
      <sequenceFlow id="fA1" sourceRef="debutA" targetRef="verifierEtudiant"/>
      <sequenceFlow id="fA2" sourceRef="verifierEtudiant" targetRef="gwEligible"/>
      <sequenceFlow id="fEligible" name="oui" sourceRef="gwEligible" targetRef="verifierOffre">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${etudiantEligible}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="fNonEligible" name="non" sourceRef="gwEligible" targetRef="finNonEligible"/>
      <sequenceFlow id="fA3" sourceRef="verifierOffre" targetRef="controler"/>
      <sequenceFlow id="fA4" sourceRef="controler" targetRef="finA"/>
    </subProcess>
    <boundaryEvent id="errA" name="Service indisponible" attachedToRef="spVerifications">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <exclusiveGateway id="gwRecevable" name="5. Conditions satisfaites ?" default="fNonRecevable"/>
    <serviceTask id="notifierRejet" name="Notifier le rejet à l'étudiant [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
      <extensionElements>
        <flowable:field name="type" stringValue="REJET_CANDIDATURE"/>
        <flowable:field name="destinataire" stringValue="ETUDIANT"/>
      </extensionElements>
    </serviceTask>
    <endEvent id="finRejet" name="Candidature rejetée"/>
    <subProcess id="spEnregistrement" name="Enregistrement et transmission">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('etapeCourante', 'ENREGISTREMENT')}"/>
      </extensionElements>
      <startEvent id="debutB" name=""/>
      <serviceTask id="enregistrer" name="Enregistrer la candidature [REST Candidatures]" flowable:class="com.universite.stages.bpmn.delegates.EnregistrerCandidatureDelegate">
        <documentation>POST /api/candidatures</documentation>
      </serviceTask>
      <serviceTask id="notifierConfirmation" name="Confirmer le dépôt à l'étudiant [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
        <extensionElements>
          <flowable:field name="type" stringValue="CONFIRMATION_DEPOT"/>
          <flowable:field name="destinataire" stringValue="ETUDIANT"/>
        </extensionElements>
      </serviceTask>
      <serviceTask id="notifierEntreprise" name="6. Transmettre à l'entreprise [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
        <extensionElements>
          <flowable:field name="type" stringValue="RECEPTION_CANDIDATURE"/>
          <flowable:field name="destinataire" stringValue="ENTREPRISE"/>
        </extensionElements>
      </serviceTask>
      <endEvent id="finB" name=""/>
      <sequenceFlow id="fB1" sourceRef="debutB" targetRef="enregistrer"/>
      <sequenceFlow id="fB2" sourceRef="enregistrer" targetRef="notifierConfirmation"/>
      <sequenceFlow id="fB3" sourceRef="notifierConfirmation" targetRef="notifierEntreprise"/>
      <sequenceFlow id="fB4" sourceRef="notifierEntreprise" targetRef="finB"/>
    </subProcess>
    <boundaryEvent id="errB" name="Service indisponible" attachedToRef="spEnregistrement">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <userTask id="evaluer" name="7. Examiner et évaluer la candidature" flowable:candidateGroups="entreprise">
      <extensionElements>
        <flowable:formProperty id="decision" name="Décision" type="enum" required="true">
          <flowable:value id="ACCEPTEE" name="Accepter"/>
          <flowable:value id="REFUSEE" name="Refuser"/>
          <flowable:value id="COMPLEMENT" name="Demander un complément"/>
        </flowable:formProperty>
        <flowable:formProperty id="commentaireDecision" name="Commentaire" type="string"/>
        <flowable:formProperty id="dateDebut" name="Date de début" type="string"/>
        <flowable:formProperty id="dateFin" name="Date de fin" type="string"/>
        <flowable:formProperty id="tuteur" name="Tuteur entreprise" type="string"/>
      </extensionElements>
    </userTask>
    <boundaryEvent id="timerRelance" name="Délai de décision dépassé" attachedToRef="evaluer" cancelActivity="false">
      <timerEventDefinition><timeDuration>${delaiRelance}</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="relancerEntreprise" name="Relancer l'entreprise [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
      <extensionElements>
        <flowable:field name="type" stringValue="RELANCE_DECISION"/>
        <flowable:field name="destinataire" stringValue="ENTREPRISE"/>
      </extensionElements>
    </serviceTask>
    <endEvent id="finRelance" name="Relance envoyée"/>
    <exclusiveGateway id="gwDecision" name="Décision ?" default="fDecisionFinale"/>
    <serviceTask id="notifierComplement" name="Demander un complément [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
      <extensionElements>
        <flowable:field name="type" stringValue="DEMANDE_COMPLEMENT"/>
        <flowable:field name="destinataire" stringValue="ETUDIANT"/>
      </extensionElements>
    </serviceTask>
    <subProcess id="spFinalisation" name="Finalisation de la décision">
      <extensionElements>
        <flowable:executionListener event="start" expression="${execution.setVariable('etapeCourante', 'FINALISATION')}"/>
      </extensionElements>
      <startEvent id="debutC" name=""/>
      <serviceTask id="majDecision" name="Enregistrer la décision [REST Candidatures]" flowable:class="com.universite.stages.bpmn.delegates.MajStatutCandidatureDelegate">
        <extensionElements>
          <flowable:field name="statut" expression="${decision}"/>
        </extensionElements>
      </serviceTask>
      <serviceTask id="notifierResultat" name="8. Notifier le résultat à l'étudiant [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
        <extensionElements>
          <flowable:field name="type" expression="${decision == 'ACCEPTEE' ? 'ACCEPTATION' : 'REFUS'}"/>
          <flowable:field name="destinataire" stringValue="ETUDIANT"/>
        </extensionElements>
      </serviceTask>
      <exclusiveGateway id="gwAcceptee" name="Acceptée ?" default="fRefusee"/>
      <serviceTask id="creerStage" name="9. Créer le dossier de stage [REST Suivi des stages]" flowable:class="com.universite.stages.bpmn.delegates.CreerDossierStageDelegate">
        <documentation>POST /api/stages</documentation>
      </serviceTask>
      <serviceTask id="majEtudiant" name="Statut étudiant EN_STAGE + réservation de place [SOAP]" flowable:class="com.universite.stages.bpmn.delegates.MajEtudiantEtOffreDelegate">
        <documentation>changerStatutEtudiant + reserverPlace</documentation>
      </serviceTask>
      <endEvent id="finAcceptee" name="Stage créé"/>
      <endEvent id="finRefusee" name="Refus notifié"/>
      <sequenceFlow id="fC1" sourceRef="debutC" targetRef="majDecision"/>
      <sequenceFlow id="fC2" sourceRef="majDecision" targetRef="notifierResultat"/>
      <sequenceFlow id="fC3" sourceRef="notifierResultat" targetRef="gwAcceptee"/>
      <sequenceFlow id="fAcceptee" name="oui" sourceRef="gwAcceptee" targetRef="creerStage">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'ACCEPTEE'}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="fRefusee" name="non" sourceRef="gwAcceptee" targetRef="finRefusee"/>
      <sequenceFlow id="fC4" sourceRef="creerStage" targetRef="majEtudiant"/>
      <sequenceFlow id="fC5" sourceRef="majEtudiant" targetRef="finAcceptee"/>
    </subProcess>
    <boundaryEvent id="errC" name="Service indisponible" attachedToRef="spFinalisation">
      <errorEventDefinition errorRef="ErreurTechnique"/>
    </boundaryEvent>
    <endEvent id="finTraitee" name="Candidature traitée"/>
    <serviceTask id="journaliser" name="Journaliser l'incident technique" flowable:class="com.universite.stages.bpmn.delegates.JournaliserIncidentDelegate">
    </serviceTask>
    <userTask id="traiterIncident" name="Traiter l'incident (relancer / abandonner)" flowable:candidateGroups="responsable">
      <extensionElements>
        <flowable:formProperty id="actionIncident" name="Action" type="enum" required="true">
          <flowable:value id="RELANCER" name="Relancer l'étape"/>
          <flowable:value id="ABANDONNER" name="Abandonner le traitement"/>
        </flowable:formProperty>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="gwIncident" name="Action ?" default="fAbandon"/>
    <serviceTask id="notifierIncident" name="Informer l'étudiant de l'abandon [REST Notifications]" flowable:class="com.universite.stages.bpmn.delegates.NotifierDelegate">
      <extensionElements>
        <flowable:field name="type" stringValue="INCIDENT_TRAITEMENT"/>
        <flowable:field name="destinataire" stringValue="ETUDIANT"/>
      </extensionElements>
    </serviceTask>
    <endEvent id="finAbandon" name="Traitement abandonné"/>
    <sequenceFlow id="f1" sourceRef="debut" targetRef="receptionner"/>
    <sequenceFlow id="f2" sourceRef="receptionner" targetRef="spVerifications"/>
    <sequenceFlow id="f3" sourceRef="spVerifications" targetRef="gwRecevable"/>
    <sequenceFlow id="fRecevable" name="oui" sourceRef="gwRecevable" targetRef="spEnregistrement">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${recevable}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fNonRecevable" name="non" sourceRef="gwRecevable" targetRef="notifierRejet"/>
    <sequenceFlow id="fRejet" sourceRef="notifierRejet" targetRef="finRejet"/>
    <sequenceFlow id="f4" sourceRef="spEnregistrement" targetRef="evaluer"/>
    <sequenceFlow id="f5" sourceRef="evaluer" targetRef="gwDecision"/>
    <sequenceFlow id="fComplement" name="complément" sourceRef="gwDecision" targetRef="notifierComplement">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'COMPLEMENT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRetourEvaluation" sourceRef="notifierComplement" targetRef="evaluer"/>
    <sequenceFlow id="fDecisionFinale" name="acceptée / refusée" sourceRef="gwDecision" targetRef="spFinalisation"/>
    <sequenceFlow id="fTimer" sourceRef="timerRelance" targetRef="relancerEntreprise"/>
    <sequenceFlow id="fRelance" sourceRef="relancerEntreprise" targetRef="finRelance"/>
    <sequenceFlow id="f6" sourceRef="spFinalisation" targetRef="finTraitee"/>
    <sequenceFlow id="fErrA" sourceRef="errA" targetRef="journaliser"/>
    <sequenceFlow id="fErrB" sourceRef="errB" targetRef="journaliser"/>
    <sequenceFlow id="fErrC" sourceRef="errC" targetRef="journaliser"/>
    <sequenceFlow id="f7" sourceRef="journaliser" targetRef="traiterIncident"/>
    <sequenceFlow id="f8" sourceRef="traiterIncident" targetRef="gwIncident"/>
    <sequenceFlow id="fRelancerA" name="relancer (vérifications)" sourceRef="gwIncident" targetRef="spVerifications">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionIncident == 'RELANCER' && etapeCourante == 'VERIFICATIONS'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRelancerB" name="relancer (enregistrement)" sourceRef="gwIncident" targetRef="spEnregistrement">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionIncident == 'RELANCER' && etapeCourante == 'ENREGISTREMENT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fRelancerC" name="relancer (finalisation)" sourceRef="gwIncident" targetRef="spFinalisation">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionIncident == 'RELANCER' && etapeCourante == 'FINALISATION'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="fAbandon" name="abandonner" sourceRef="gwIncident" targetRef="notifierIncident"/>
    <sequenceFlow id="f9" sourceRef="notifierIncident" targetRef="finAbandon"/>
  </process>

